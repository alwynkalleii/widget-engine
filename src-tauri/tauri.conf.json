{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "widget-engine",
  "version": "0.1.0",
  "identifier": "cc.fjzf.widget-engine",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "widget-engine",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMEMyMUU2QjlBRDVGQjYKUldTMlg2MjU1aUVNMnJOWVBaUzNNS0p5allySW5QRkZ5TU9uamtodk9mdUNSNUw4QUF3Mk5GejgK",
      "endpoints": ["https://github.com/alwynkalleii/widget-engine/releases/latest/download/latest.json"]
    }
  }
}
